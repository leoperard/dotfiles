# Brewfile - Declarative package management for macOS

# Taps
tap "homebrew/bundle"

# Core Terminal & CLI Utilities
brew "zsh"
brew "tmux"
brew "neovim"
brew "git"
brew "gh"
brew "ripgrep"
brew "fd"
brew "jq"
brew "fzf"
brew "tree"
brew "wget"

# Shell enhancements & Productivity
brew "autojump"
brew "thefuck"
brew "uv"

# Cloud & Container Tooling
brew "kubectl"
brew "kubectx"
brew "helm"

# Terminal Emulator & GUI Applications
cask "alacritty"

# Nerd Fonts (required for Powerlevel10k and terminal glyphs)
cask "font-meslo-lg-nerd-font"
